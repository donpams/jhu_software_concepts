# Copy to .env (git-ignored) and fill in.  The app assembles
#   postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
# Use the least-privilege role from db/create_app_user.sql, never a superuser.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradcafe
DB_USER=gradcafe_app
DB_PASSWORD=change-me

# Optional: a full URL overrides the five values above (CI and tests use this).
# DATABASE_URL=postgresql://gradcafe_app:change-me@localhost:5432/gradcafe
# TEST_DATABASE_URL=postgresql://gradcafe_test:change-me@localhost:5432/gradcafe_test

# Optional
# FLASK_SECRET_KEY=change-me
# PORT=5000
